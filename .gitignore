# ══════════════════════════════════════════════════════════════════════════════
# OrangeBite Monorepo — Root .gitignore
# Applies to the entire repo (Backend/ + Frontend/).
# Each sub-directory also carries its own .gitignore for local specifics.
# ══════════════════════════════════════════════════════════════════════════════

# ── Environment variables — NEVER commit secrets ──────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
**/.env
**/.env.local
**/.env.*.local
*.env

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
dist-ssr/
.next/
out/
**/dist/
**/build/

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/
**/.vite/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
combined.log
error.log

# ── Uploaded / generated files ────────────────────────────────────────────────
uploads/
**/uploads/
tmp/
temp/

# ── Coverage & test artefacts ─────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# ── OS & editor files ─────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
